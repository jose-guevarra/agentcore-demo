# flush_memory.sh Config file
# Copy this file to .env.flush_memory and replace with your actual values

AWS_REGION="us-east-1"

# terraform -chdir=infra/acdemo output memory_id
MEMORY_ID=""

# ACTOR_ID is one per user (webapp-<cognito sub>, see
# webapp/agent_client.py's actor_id_for_user) and is shared across all of
# that user's chats. SESSION_ID identifies one specific chat under that
# actor -- either "webapp-<sub>-<conversation id>" for a chat created after
# multi-chat support was added, or bare "webapp-<sub>" (== ACTOR_ID) for a
# conversation that predates it. To flush every chat a user has at once, use
# flush_all_chats.sh instead.
ACTOR_ID="webapp-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
SESSION_ID="webapp-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
